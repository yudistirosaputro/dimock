{
  "name": "dimock",
  "version": "0.1.0-alpha01",
  "description": "Agent-native Android HTTP inspector and mock injector: CLI and MCP server for the dimock Android library.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dimock": "dist/cli/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test --import tsx 'src/**/__tests__/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "keywords": [
    "android",
    "mock",
    "http",
    "interceptor",
    "okhttp",
    "mcp",
    "claude-code",
    "chucker",
    "adb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yudistirosaputro/dimock.git",
    "directory": "packages/dimock"
  },
  "homepage": "https://github.com/yudistirosaputro/dimock#readme",
  "bugs": {
    "url": "https://github.com/yudistirosaputro/dimock/issues"
  }
}
